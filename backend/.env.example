# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# PostgreSQL — application role (used by the API at runtime)
DATABASE_URL=postgresql://financas_app:change_this_app_password@localhost:5432/financas

# PostgreSQL — superuser connection (used ONLY by the migration runner)
# Required for migrations that create functions, schemas, or roles.
# In Docker this is set automatically by docker-compose.yml; set it here for local runs.
DATABASE_ADMIN_URL=postgresql://postgres:change_this_superuser_password@localhost:5432/financas

# Express port (optional, defaults to 3001)
PORT=3001

# JWT — generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_random_64_byte_hex_string
JWT_EXPIRES_IN=15m

# Refresh token lifetime in days (default: 7)
REFRESH_TOKEN_EXPIRES_DAYS=7

# Allowed CORS origin for the frontend (dev only; in prod everything goes through nginx)
CORS_ORIGIN=http://localhost:5173
